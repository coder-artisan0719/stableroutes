# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/stableroute?schema=public"

# NextAuth v5
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional — sign in with Google is hidden until both are set)
# 1. Visit https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID (type: Web application)
# 3. Authorized redirect URI: http://localhost:3000/api/auth/callback/google
#    (add your production URL too once deployed)
# 4. Paste the values below
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend (https://resend.com)
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="StableRoute <no-reply@stableroute.io>"

# Admin seed credentials (used by prisma/seed.ts).
# These are written to the DB on `npm run db:seed`. Change them before seeding,
# or change them here and re-run `npm run db:seed` to update the existing admin.
ADMIN_EMAIL="admin@stableroute.io"
ADMIN_PASSWORD="Admin12345!"

# App
NEXT_PUBLIC_APP_NAME="StableRoute"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
