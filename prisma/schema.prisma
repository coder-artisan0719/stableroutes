// StableRoute Prisma schema
// Custom-named USD bank for ACH + Wire transfers, settled to USDC (Base)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Used by `prisma migrate` / `db push` — must be the non-pooled (direct) URL.
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum UserRole {
  ADMIN
  CUSTOMER
}

enum ProfileStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TransactionStatus {
  SCHEDULED
  PENDING
  COMPLETED
  REFUNDED
  CANCELLED
}

enum TransactionType {
  ACH
  WIRE
}

/// Which methods the bank account assigned to a profile accepts.
enum TransferMethod {
  ACH
  WIRE
  BOTH
}

/// Currency of the bank account a customer requests for a profile.
enum AccountCurrency {
  USD
  EUR
  GBP
  CAD
}

enum NotificationChannel {
  EMAIL
  IN_APP
}

enum AnnouncementType {
  FEATURE
  MAINTENANCE
  GENERAL
}

// -----------------------------------------------------------------------------
// Auth (NextAuth + custom fields)
// -----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  /// Nullable — OAuth-only accounts (e.g. Google sign-in) won't have one.
  passwordHash  String?
  role          UserRole  @default(CUSTOMER)
  name          String?
  image         String?
  twoFactor     Boolean   @default(false)
  /// TOTP shared secret (base32). Set when the customer begins 2FA setup;
  /// `twoFactor` only flips true once they confirm a code from their app.
  twoFactorSecret String?

  // Account suspension (e.g. for fraud). Blocked users cannot sign in.
  blocked       Boolean   @default(false)
  blockedReason String?
  blockedAt     DateTime?

  // Referral program: each user has their own shareable code, and may have
  // been referred by another user (set at signup from a ?ref= code).
  referralCode  String?   @unique
  referredById  String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profiles     CustomerProfile[]
  transactions Transaction[]
  sessions     Session[]
  accounts     Account[]
  notifications Notification[]

  referredBy   User?  @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals    User[] @relation("UserReferrals")

  @@index([role])
  @@index([referredById])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// -----------------------------------------------------------------------------
// Domain
// -----------------------------------------------------------------------------

/// A customer's named bank profile. A customer may have multiple profiles.
/// Bank details (accountNumber, routingNumber, bankName, bankAddress, transferMethod)
/// are assigned by an admin at approval time — they're not editable by the customer.
model CustomerProfile {
  id                String        @id @default(cuid())
  userId            String
  firstName         String
  /// Optional — part of the account holder's legal name.
  middleName        String?
  lastName          String
  senderName        String
  /// Bank account currency the customer requested for this profile.
  accountCurrency   AccountCurrency @default(USD)
  /// USDC (Base) withdrawal address — destination of settled funds.
  withdrawalAddress String
  status            ProfileStatus @default(PENDING)
  notes             String?
  approvedAt        DateTime?
  approvedById      String?

  // Bank details (admin-assigned at approval)
  accountNumber  String?
  routingNumber  String?
  bankName       String?
  bankAddress    String?
  transferMethod TransferMethod?
  /// Commission fee for this profile, as a whole percent. Set at approval,
  /// editable by admin anytime. New transactions snapshot this rate.
  commissionPct  Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@index([status])
}

/// A single ACH or Wire deposit, ultimately settled to the profile's withdrawal address.
model Transaction {
  id            String            @id @default(cuid())
  reference     String            @unique @default(cuid())
  userId        String
  profileId     String
  amountCents   Int
  currency      String            @default("USD")
  /// Effective commission for this transfer as a percent (e.g. 4.5 = 4.5%).
  /// Snapshotted at creation: the profile's base rate minus any referral discount.
  commissionPct Float             @default(0)
  type          TransactionType
  status        TransactionStatus @default(PENDING)
  senderName    String
  description   String?
  adminNote     String?
  refundReason  String?
  /// On-chain transaction hash for the USDC settlement on Base (set when COMPLETED).
  txHash        String?
  /// When the transfer is scheduled to be processed (only set when status = SCHEDULED).
  scheduledFor  DateTime?
  completedAt   DateTime?
  refundedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile CustomerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // Composite indexes serve the filter + "ORDER BY createdAt DESC" together,
  // so paginated listings need no separate sort step. The leading column also
  // covers plain `WHERE userId` / `WHERE status` lookups.
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([profileId])
  @@index([createdAt])
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  channel   NotificationChannel @default(EMAIL)
  subject   String
  body      String              @db.Text
  /// IN_APP only: where the notification links to, and when it was read.
  url       String?
  readAt    DateTime?
  sentAt    DateTime?
  error     String?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, channel])
  @@index([sentAt])
}

/// A broadcast announcement sent to customers from the admin panel — kept as a
/// history record of what was sent, when, and to how many recipients.
model Announcement {
  id             String           @id @default(cuid())
  type           AnnouncementType
  subject        String
  message        String           @db.Text
  /// Optional human-readable time included in the announcement (e.g. a window).
  scheduledLabel String?
  /// How many customers it was emailed to.
  recipientCount Int              @default(0)
  createdAt      DateTime         @default(now())

  @@index([createdAt])
}
