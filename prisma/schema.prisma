// StableRoute Prisma schema
// Custom-named USD bank for ACH + Wire transfers, settled to USDC (Base)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Used by `prisma migrate` / `db push` — must be the non-pooled (direct) URL.
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum UserRole {
  ADMIN
  CUSTOMER
}

enum ProfileStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TransactionStatus {
  SCHEDULED
  PENDING
  COMPLETED
  REFUNDED
  CANCELLED
}

enum TransactionType {
  ACH
  WIRE
}

/// Which methods the bank account assigned to a profile accepts.
enum TransferMethod {
  ACH
  WIRE
  BOTH
}

/// Currency of the bank account a customer requests for a profile.
enum AccountCurrency {
  USD
  EUR
  GBP
  CAD
}

enum NotificationChannel {
  EMAIL
  IN_APP
}

enum AnnouncementType {
  FEATURE
  MAINTENANCE
  GENERAL
}

/// Admin to-do categories. These let the team filter the queue by what kind
/// of follow-up is needed and let auto-generated reminders flag themselves.
enum AdminTaskCategory {
  PAYMENT_HOLD          // payment received but withheld pending confirmation
  PENDING_CONFIRMATION  // waiting on customer / bank to confirm something
  RESTRICTED_ACCOUNT    // blocked or flagged account that needs follow-up
  PROFILE_REVIEW        // profile sitting in PENDING longer than expected
  SCHEDULED_TRANSFER    // scheduled transfer whose ETA is approaching
  REFUND_FOLLOWUP       // refund initiated but settlement not finalised
  COMPLIANCE_REVIEW     // KYC / risk review owed to compliance
  OTHER
}

enum AdminTaskStatus {
  OPEN
  SNOOZED
  RESOLVED
}

enum AdminTaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// -----------------------------------------------------------------------------
// Auth (NextAuth + custom fields)
// -----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  /// Nullable — OAuth-only accounts (e.g. Google sign-in) won't have one.
  passwordHash  String?
  role          UserRole  @default(CUSTOMER)
  name          String?
  image         String?
  twoFactor     Boolean   @default(false)
  /// TOTP shared secret (base32). Set when the customer begins 2FA setup;
  /// `twoFactor` only flips true once they confirm a code from their app.
  twoFactorSecret String?

  // Account suspension (e.g. for fraud). Blocked users cannot sign in.
  blocked       Boolean   @default(false)
  blockedReason String?
  blockedAt     DateTime?

  /// Telegram contact handle/ID for the customer — used by admins to reach
  /// out about payment confirmations and follow-up tasks. Stored as text so
  /// it can hold either a @username or a numeric chat ID.
  telegramId    String?

  // Referral program: each user has their own shareable code, and may have
  // been referred by another user (set at signup from a ?ref= code).
  referralCode  String?   @unique
  referredById  String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profiles     CustomerProfile[]
  transactions Transaction[]
  sessions     Session[]
  accounts     Account[]
  notifications Notification[]
  loginEvents  LoginEvent[]
  // Admin follow-up tasks pinned to this customer (e.g. payment holds, KYC).
  adminTasks   AdminTask[]   @relation("AdminTaskCustomer")
  // Admin follow-up tasks created by this user (when role = ADMIN).
  adminTasksCreated AdminTask[] @relation("AdminTaskCreator")
  // Admin follow-up tasks resolved by this user.
  adminTasksResolved AdminTask[] @relation("AdminTaskResolver")

  referredBy   User?  @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals    User[] @relation("UserReferrals")

  @@index([role])
  @@index([referredById])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Successful sign-in audit log — captures device + IP geolocation each time
/// a user signs in so they (and admins) can spot unrecognised activity.
model LoginEvent {
  id        String   @id @default(cuid())
  userId    String
  /// Auth provider used: "credentials", "google", etc.
  provider  String
  /// Human-friendly parse of the user agent, e.g. "Chrome on macOS".
  device    String
  userAgent String?  @db.Text
  ip        String?
  city      String?
  region    String?
  country   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// -----------------------------------------------------------------------------
// Domain
// -----------------------------------------------------------------------------

/// A customer's named bank profile. A customer may have multiple profiles.
/// Bank details (accountNumber, routingNumber, bankName, bankAddress, transferMethod)
/// are assigned by an admin at approval time — they're not editable by the customer.
model CustomerProfile {
  id                String        @id @default(cuid())
  userId            String
  firstName         String
  /// Optional — part of the account holder's legal name.
  middleName        String?
  lastName          String
  senderName        String
  /// Bank account currency the customer requested for this profile.
  accountCurrency   AccountCurrency @default(USD)
  /// USDC (Base) withdrawal address — destination of settled funds.
  withdrawalAddress String
  /// Pending replacement address the customer has submitted but an admin
  /// has not yet approved. While non-null, the live `withdrawalAddress`
  /// continues to serve as the settlement target.
  pendingWithdrawalAddress    String?
  /// When the pending address change was requested, for the admin queue.
  pendingWithdrawalRequestedAt DateTime?
  /// AI-generated anomaly score 0–100 for the pending address change. Null
  /// until OpenAI is configured & the request goes through scoring.
  pendingAddressRiskScore      Int?
  /// Short bullet reasons backing the anomaly score. Cleared together with
  /// the pending address columns when the request is approved or rejected.
  pendingAddressRiskReasons    String[]
  status            ProfileStatus @default(PENDING)
  notes             String?
  approvedAt        DateTime?
  approvedById      String?

  // Bank details (admin-assigned at approval)
  accountNumber  String?
  routingNumber  String?
  bankName       String?
  bankAddress    String?
  transferMethod TransferMethod?
  /// Commission fee for this profile, as a whole percent. Set at approval,
  /// editable by admin anytime. New transactions snapshot this rate.
  commissionPct  Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  adminTasks   AdminTask[]

  @@index([userId])
  @@index([status])
}

/// A single ACH or Wire deposit, ultimately settled to the profile's withdrawal address.
model Transaction {
  id            String            @id @default(cuid())
  reference     String            @unique @default(cuid())
  userId        String
  profileId     String
  amountCents   Int
  currency      String            @default("USD")
  /// Effective commission for this transfer as a percent (e.g. 4.5 = 4.5%).
  /// Snapshotted at creation: the profile's base rate minus any referral discount.
  commissionPct Float             @default(0)
  type          TransactionType
  status        TransactionStatus @default(PENDING)
  senderName    String
  description   String?
  adminNote     String?
  refundReason  String?
  /// On-chain transaction hash for the USDC settlement on Base (set when COMPLETED).
  txHash        String?
  /// Risk score 0–100 generated by OpenAI on creation. Null when AI was not
  /// configured at the time the row was created. Higher = more suspicious.
  riskScore     Int?
  /// Bullet-point reasons backing the score. Stored as a Postgres text array
  /// so we can render them without a separate join.
  riskReasons   String[]
  /// When the risk score was generated (separate from createdAt so re-scoring
  /// later is possible). Null = never analysed.
  riskAnalyzedAt DateTime?
  /// When the transfer is scheduled to be processed (only set when status = SCHEDULED).
  scheduledFor  DateTime?
  completedAt   DateTime?
  refundedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile     CustomerProfile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  expenseRate TransactionExpenseRate?
  adminTasks  AdminTask[]

  // Composite indexes serve the filter + "ORDER BY createdAt DESC" together,
  // so paginated listings need no separate sort step. The leading column also
  // covers plain `WHERE userId` / `WHERE status` lookups.
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([profileId])
  @@index([createdAt])
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  channel   NotificationChannel @default(EMAIL)
  subject   String
  body      String              @db.Text
  /// IN_APP only: where the notification links to, and when it was read.
  url       String?
  readAt    DateTime?
  sentAt    DateTime?
  error     String?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, channel])
  @@index([sentAt])
}

/// A broadcast announcement sent to customers from the admin panel — kept as a
/// history record of what was sent, when, and to how many recipients.
model Announcement {
  id             String           @id @default(cuid())
  type           AnnouncementType
  subject        String
  message        String           @db.Text
  /// Optional human-readable time included in the announcement (e.g. a window).
  scheduledLabel String?
  /// How many customers it was emailed to.
  recipientCount Int              @default(0)
  createdAt      DateTime         @default(now())

  @@index([createdAt])
}

/// Per-transaction expense (cost) rate used by the passcode-protected admin
/// Revenue page. Kept in its own table so this sensitive cost data is never
/// returned by ordinary transaction queries — it is only read on the Revenue
/// page, and each transaction's rate is fully independent of the others.
model TransactionExpenseRate {
  transactionId String   @id
  expensePct    Float    @default(0)
  updatedAt     DateTime @updatedAt

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

/// An internal admin to-do for following up on a customer or payment — e.g. a
/// payment received but withheld pending confirmation, a restricted account
/// that needs review, or a pending profile that's been sitting too long.
/// Tasks can be hand-created by an admin OR auto-generated by the auto-detect
/// action (which scans the DB for overdue items and seeds OPEN tasks).
model AdminTask {
  id            String            @id @default(cuid())
  title         String
  category      AdminTaskCategory @default(OTHER)
  status        AdminTaskStatus   @default(OPEN)
  priority      AdminTaskPriority @default(NORMAL)

  // Optional links: the customer this task is about, and the specific profile
  // / transaction it relates to. customerId is the most-used filter.
  customerId    String?
  profileId     String?
  transactionId String?

  // Snapshotted display fields — kept even if the linked row is later deleted
  // so the queue still shows useful context.
  customerEmail String?
  profileName   String?

  // Money context (snapshotted at creation): the paid amount we're holding
  // and when the customer paid us. amountCents is optional because tasks
  // unrelated to money (e.g. KYC review) won't have one.
  amountCents   Int?
  paidAt        DateTime?

  /// When this task needs to be actioned by. Drives the "overdue" sort.
  dueAt         DateTime?
  /// When SNOOZED, the time it should pop back into OPEN. Cleared on resume.
  snoozedUntil  DateTime?

  /// Why the admin hasn't actioned the linked payment yet — the user's main
  /// requirement. Plain text so the team can capture whatever's relevant.
  reason        String?           @db.Text
  /// Free-form additional notes (steps tried, related ticket links, etc.).
  notes         String?           @db.Text

  /// true when this row was inserted by the auto-detect sweep rather than by
  /// a human. Used to avoid showing duplicate auto-tasks for the same anchor.
  autoGenerated Boolean           @default(false)

  createdById   String?
  resolvedById  String?
  resolvedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  customer   User?            @relation("AdminTaskCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  profile    CustomerProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  transaction Transaction?    @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  createdBy  User?            @relation("AdminTaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  resolvedBy User?            @relation("AdminTaskResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, dueAt])
  @@index([category, status])
  @@index([customerId, status])
  @@index([transactionId])
}
